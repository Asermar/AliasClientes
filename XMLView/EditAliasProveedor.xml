<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <group name="data" numcolumns="12">
            <column name="id" display="none" order="100">
                <widget type="text" fieldname="id" readonly="true"/>
            </column>
            <column name="alias-type" display="none" order="110">
                <widget type="text" fieldname="aliastype" maxlength="30" required="true"/>
            </column>
            <column name="cod" display="none" order="120">
                <widget type="text" fieldname="cod" maxlength="50" required="true"/>
            </column>
            <column name="alias" order="130">
                <widget type="text" fieldname="alias" maxlength="50" required="true"/>
            </column>
            <column name="favorite" order="140" display="center">
                <widget type="checkbox" fieldname="favorite"/>
            </column>
        </group>
    </columns>
</view>
